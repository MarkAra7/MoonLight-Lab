# ---------------------------------------------------------------------------
# MoonLight Lab - Docker environment (example)
#
# Copy this file to `.env.docker` and adjust the secrets.
# `.env.docker` is gitignored - never commit real passwords.
#
# APP_KEY:  generate one with:  php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=MoonLight Lab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=moonlight
DB_USERNAME=moonlight
DB_PASSWORD=change_me
MYSQL_DATABASE=moonlight
MYSQL_USER=moonlight
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Session / queue / cache (all DB-backed, no Redis needed) ---
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Sanctum (SPA cookie auth via the frontend proxy) ---
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost

# --- Mail (disabled for now - switch to smtp when needed) ---
MAIL_MAILER=log

# --- Misc ---
LOG_CHANNEL=stack
LOG_LEVEL=debug
BCRYPT_ROUNDS=12
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
FILESYSTEM_DISK=local